{
  "name": "attendance-app-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "professional-backend-structure-main"
  ],
  "scripts": {
    "build": "npm run build --workspace=frontend",
    "dev:backend": "npm run dev --workspace=professional-backend-structure-main",
    "dev:frontend": "npm run dev --workspace=frontend",
    "seed": "npm run seed --workspace=professional-backend-structure-main",
    "migrate:atlas": "npm run migrate:atlas --workspace=professional-backend-structure-main"
  }
}
