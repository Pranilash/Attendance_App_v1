{
  "version": 2,
  "builds": [
    {
      "src": "professional-backend-structure-main/api/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "professional-backend-structure-main/src/**/*",
          "professional-backend-structure-main/public/**/*"
        ]
      }
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "professional-backend-structure-main/api/index.js"
    },
    {
      "src": "/health",
      "dest": "professional-backend-structure-main/api/index.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
